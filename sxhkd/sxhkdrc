########################################
# Media buttons keybindings            #
########################################
# Increase volume
@XF86AudioRaiseVolume
    volume-ctl up

# Decrease volume
@XF86AudioLowerVolume
    volume-ctl down

# Mute output
@XF86AudioMute
    volume-ctl mute

# Mute mic
@XF86AudioMicMute
    volume-ctl mic-mute

# Play/pause
@XF86AudioPlay
    playerctl play-pause

@XF86MonBrightnessUp
    brightnessctl set 10%+

@XF86MonBrightnessDown
    brightnessctl set 10%-

########################################
# Keybindings for launch applications  #
########################################
ctrl + alt + t
    $TERMINAL

ctrl + alt + b
    $BROWSER

ctrl + alt + n
    $TERMINAL nmtui

ctrl + alt + f
    $TERMINAL lf

ctrl + alt + l
    logseq

ctrl + alt + c
    $TERMINAL bc

ctrl + alt + m
    $TERMINAL ncpamixer

ctrl + alt + p
    $TERMINAL rmpc

########################################
# Screencapture                        #
########################################
alt + shift + 3
    screencapture -e

alt + shift + 4
    screencapture -ei

alt + shift + ctrl + 3
    screencapture -ec

alt + shift + ctrl + 4
    screencapture -rc

########################################
# System keybindings                   #
########################################
# keyboard layout switch
ctrl + space
    kb-layout-ctl

# screenlock
ctrl + alt + @q
    screenlock -s

# reload sxhkd config file
ctrl + shift + r
    reload-sxhkd

